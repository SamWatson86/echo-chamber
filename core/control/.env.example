# Example control plane env
CORE_BIND=0.0.0.0
CORE_PORT=9443
# For real Let's Encrypt cert (recommended):
CORE_TLS_CERT=certs/live/echo.fellowshipoftheboatrace.party-chain.pem
CORE_TLS_KEY=certs/live/echo.fellowshipoftheboatrace.party-key.pem
# For self-signed cert (development only):
# CORE_TLS_SELF_SIGNED=1

# Admin auth (use hash for production)
CORE_ADMIN_PASSWORD=ChangeMe
# CORE_ADMIN_PASSWORD_HASH=
CORE_ADMIN_JWT_SECRET=ChangeThisSecret
CORE_ADMIN_TOKEN_TTL_SECS=43200

# Owner-only diagnostics (disabled unless explicitly configured)
# Generate a unique random value of at least 32 bytes. Never reuse the room,
# admin JWT, LiveKit, TURN, Jam source, or GitHub credential.
# CORE_DIAGNOSTICS_OWNER_SECRET=
# CORE_DIAGNOSTICS_DIR=../logs/diagnostics
# CORE_DIAGNOSTICS_RETENTION_DAYS=14
# CORE_DIAGNOSTICS_MAX_MB=100

# LiveKit API key/secret (must match your livekit.yaml)
LK_API_KEY=LK_API_KEY
LK_API_SECRET=LK_API_SECRET
LK_TOKEN_TTL_SECS=14400

# Spotify OAuth and Jam source helper
SPOTIFY_CLIENT_ID=YOUR-SPOTIFY-APP-CLIENT-ID
# The source runs in the interactive Windows session on the Spotify PC.
# Generate a long random token; this is deliberately separate from user/admin auth.
JAM_SOURCE_ID=spotify-host
JAM_SOURCE_TOKEN=replace-with-a-long-random-token
# For stable, long-lived configuration, prefer an exact unique device name.
# Spotify device IDs can rotate; use an ID only when names are ambiguous and update it if it changes.
SPOTIFY_DEVICE_NAME=YOUR-SPOTIFY-DESKTOP-NAME
# SPOTIFY_DEVICE_ID=

# Soundboard storage
CORE_SOUNDBOARD_DIR=../logs/soundboard
CORE_SOUNDBOARD_MAX_MB=8
CORE_SOUNDBOARD_MAX_SOUNDS_PER_ROOM=60

# TURN server credentials (must match core/turn env vars)
# If not set, viewers fall back to STUN-only (no NAT traversal)
TURN_USER=echo
TURN_PASS=change_me
TURN_PUBLIC_IP=YOUR_PUBLIC_IP_HERE
TURN_PORT=3478

# GitHub integration (optional) — auto-create Issues from bug reports
# Create a fine-grained PAT at https://github.com/settings/tokens?type=beta
# with "Issues: Read and Write" permission on your repo
GITHUB_REPO=YourUser/your-repo
GITHUB_PAT=
